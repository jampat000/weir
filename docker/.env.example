# Weir Docker environment example.
# Copy this file to `.env.weir` in the repository root if you want to override defaults:
#   docker compose --env-file .env.weir up -d

# Optional. If omitted, the container generates a high-entropy secret and persists it to:
#   $WEIR_HOME/session.secret
# To create your own:
#   openssl rand -hex 32
# WEIR_SESSION_SECRET=

# Optional. If omitted, the container generates a high-entropy secret and persists it to:
#   $WEIR_HOME/credentials.secret
# To create your own, different from WEIR_SESSION_SECRET:
#   openssl rand -hex 32
# WEIR_CREDENTIALS_SECRET=

# Persistent data root inside the container. The default compose volume maps this path.
# WEIR_HOME=/data/weir

# Optional runtime UID/GID remap for the weir user inside the container.
# Aliases PUID / PGID are also accepted.
# WEIR_PUID=1000
# WEIR_PGID=1000

# Optional image override.
# WEIR_DOCKER_IMAGE=ghcr.io/jampat000/weir:1.0.0-rc.14

# Default is auto: the sign-in cookie is HTTPS-only when the request arrives over HTTPS
# (directly, or through a proxy listed in WEIR_TRUSTED_PROXY_IPS), so plain http:// LAN access works.
# Set true to always require HTTPS, or false to never require it.
# WEIR_SESSION_COOKIE_SECURE=auto

# Optional reverse proxy trust. Only set this to the immediate trusted proxy IP/CIDR.
# WEIR_TRUSTED_PROXY_IPS=

# Weir only answers requests for its own address (an IP, localhost, a single-label name, or a
# .local/.lan/.home/.home.arpa/.internal/.localdomain name) unless the Host also appears here.
# A reverse-proxy domain needs an entry; a leading "*." also allows its subdomains.
# WEIR_ALLOWED_HOSTS=weir.example.com
